{
  "suite": "hostnames",
  "protocolVersion": 1,
  "description": "Hostname canonicalization (input.host -> expected.canonical, null when rejected), single-pattern matching (input.host + input.pattern -> expected.matches) and allowlist checks (input.host + input.patterns -> expected.allowed; an empty list allows nothing). Patterns are matched as given; they are not canonicalized. Canonicalization follows the WHATWG URL Standard as implemented by the server runtime, workerd/ada (the Workers runtime and its URL parser; Node also uses ada). Cases named runtime-normative pin that runtime's result for inputs where browsers' IDNA data differ (accept/reject only, never a different hostname); a browser that disagrees fails closed. A wildcard pattern whose base ends in an all-digit label or a label starting with 0x is invalid and matches nothing (K-3).",
  "cases": [
    { "name": "canonical: mixed case", "input": { "host": "Example.COM" }, "expected": { "canonical": "example.com" } },
    { "name": "canonical: trailing dot", "input": { "host": "example.com." }, "expected": { "canonical": "example.com" } },
    { "name": "canonical: IDN to punycode", "input": { "host": "bücher.example" }, "expected": { "canonical": "xn--bcher-kva.example" } },
    { "name": "canonical: localhost", "input": { "host": "localhost" }, "expected": { "canonical": "localhost" } },
    { "name": "canonical: IPv4 dotted", "input": { "host": "127.0.0.1" }, "expected": { "canonical": "127.0.0.1" } },
    { "name": "canonical: IPv4 hex shorthand", "input": { "host": "0x7f.1" }, "expected": { "canonical": "127.0.0.1" } },
    { "name": "canonical: port rejected", "input": { "host": "example.com:443" }, "expected": { "canonical": null } },
    { "name": "canonical: userinfo rejected", "input": { "host": "user@example.com" }, "expected": { "canonical": null } },
    { "name": "canonical: space rejected", "input": { "host": "exa mple.com" }, "expected": { "canonical": null } },
    { "name": "canonical: path rejected", "input": { "host": "example.com/x" }, "expected": { "canonical": null } },
    { "name": "canonical: empty rejected", "input": { "host": "" }, "expected": { "canonical": null } },
    { "name": "canonical: wildcard rejected", "input": { "host": "*.example.com" }, "expected": { "canonical": null } },
    { "name": "canonical: IPv6 literal rejected", "input": { "host": "[::1]" }, "expected": { "canonical": null } },
    { "name": "canonical: 64-char label rejected", "input": { "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com" }, "expected": { "canonical": null } },
    { "name": "canonical: percent escape rejected", "input": { "host": "ex%61mple.com" }, "expected": { "canonical": null } },
    { "name": "canonical: backslash rejected", "input": { "host": "example.com\\evil.com" }, "expected": { "canonical": null } },
    { "name": "canonical: query char rejected", "input": { "host": "example.com?.evil" }, "expected": { "canonical": null } },
    { "name": "canonical: fragment char rejected", "input": { "host": "example.com#.evil" }, "expected": { "canonical": null } },
    { "name": "canonical: TAB rejected", "input": { "host": "exa\tmple.com" }, "expected": { "canonical": null } },
    { "name": "canonical: NUL rejected", "input": { "host": "example.com\u0000" }, "expected": { "canonical": null } },
    { "name": "canonical: NEL (U+0085) rejected", "input": { "host": "example.com\u0085" }, "expected": { "canonical": null } },
    { "name": "canonical: full-width colon rejected", "input": { "host": "a.example.com：80" }, "expected": { "canonical": null } },
    { "name": "canonical: empty label rejected", "input": { "host": "a..example.com" }, "expected": { "canonical": null } },
    { "name": "canonical: double trailing dot rejected", "input": { "host": "example.com.." }, "expected": { "canonical": null } },
    { "name": "canonical: ideographic full stop is a dot", "input": { "host": "a。example.com" }, "expected": { "canonical": "a.example.com" } },
    { "name": "canonical: Cyrillic homoglyph becomes punycode", "input": { "host": "\u0435xample.com" }, "expected": { "canonical": "xn--xample-2of.com" } },
    { "name": "canonical: full-width letter folds to ASCII", "input": { "host": "\uff45xample.com" }, "expected": { "canonical": "example.com" } },
    { "name": "canonical: soft hyphen (U+00AD) is ignored", "input": { "host": "exa\u00admple.com" }, "expected": { "canonical": "example.com" } },
    { "name": "canonical: zero-width space (U+200B) is ignored", "input": { "host": "exa\u200bmple.com" }, "expected": { "canonical": "example.com" } },
    { "name": "canonical: BOM (U+FEFF) inside rejected", "input": { "host": "exa\ufeffmple.com" }, "expected": { "canonical": null } },
    { "name": "canonical: underscore rejected", "input": { "host": "_dmarc.example.com" }, "expected": { "canonical": null } },
    { "name": "canonical: dollar sign rejected", "input": { "host": "exa$mple.com" }, "expected": { "canonical": null } },
    { "name": "canonical: leading hyphen in a label rejected", "input": { "host": "-a.example.com" }, "expected": { "canonical": null } },
    { "name": "canonical: trailing hyphen in a label rejected", "input": { "host": "a-.example.com" }, "expected": { "canonical": null } },
    { "name": "canonical: 253 characters accepted", "input": { "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expected": { "canonical": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
    { "name": "canonical: 253 characters plus a trailing dot accepted", "input": { "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa." }, "expected": { "canonical": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
    { "name": "canonical: 254 characters rejected", "input": { "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expected": { "canonical": null } },
    { "name": "canonical: trailing newline rejected", "input": { "host": "example.com\n" }, "expected": { "canonical": null } },
    { "name": "canonical: invalid punycode rejected", "input": { "host": "xn--a.com" }, "expected": { "canonical": null } },
    { "name": "canonical: valid punycode kept", "input": { "host": "xn--bcher-kva.example" }, "expected": { "canonical": "xn--bcher-kva.example" } },

    { "name": "match: exact", "input": { "host": "example.com", "pattern": "example.com" }, "expected": { "matches": true } },
    { "name": "match: exact, host case-insensitive", "input": { "host": "EXAMPLE.com", "pattern": "example.com" }, "expected": { "matches": true } },
    { "name": "match: suffix without label boundary", "input": { "host": "evilexample.com", "pattern": "example.com" }, "expected": { "matches": false } },
    { "name": "match: host extends pattern", "input": { "host": "example.com.evil.com", "pattern": "example.com" }, "expected": { "matches": false } },
    { "name": "match: wildcard one level", "input": { "host": "a.example.com", "pattern": "*.example.com" }, "expected": { "matches": true } },
    { "name": "match: wildcard two levels", "input": { "host": "a.b.example.com", "pattern": "*.example.com" }, "expected": { "matches": true } },
    { "name": "match: wildcard excludes apex", "input": { "host": "example.com", "pattern": "*.example.com" }, "expected": { "matches": false } },
    { "name": "match: wildcard needs label boundary", "input": { "host": "aexample.com", "pattern": "*.example.com" }, "expected": { "matches": false } },
    { "name": "match: punycode pattern, punycode host", "input": { "host": "xn--bcher-kva.example", "pattern": "xn--bcher-kva.example" }, "expected": { "matches": true } },
    { "name": "match: punycode pattern, unicode host", "input": { "host": "bücher.example", "pattern": "xn--bcher-kva.example" }, "expected": { "matches": true } },
    { "name": "match: non-canonical pattern is invalid", "input": { "host": "example.com", "pattern": "Example.com" }, "expected": { "matches": false } },
    { "name": "match: wildcard on TLD is invalid", "input": { "host": "a.com", "pattern": "*.com" }, "expected": { "matches": false } },
    { "name": "match: bare wildcard is invalid", "input": { "host": "example.com", "pattern": "*" }, "expected": { "matches": false } },
    { "name": "match: integer IPv4 host", "input": { "host": "2130706433", "pattern": "127.0.0.1" }, "expected": { "matches": true } },
    { "name": "match: backslash host never matches", "input": { "host": "example.com\\evil.com", "pattern": "example.com" }, "expected": { "matches": false } },
    { "name": "match: ideographic full stop does not split label boundary", "input": { "host": "aexample。com", "pattern": "*.example.com" }, "expected": { "matches": false } },
    { "name": "match: Cyrillic homoglyph host does not match ASCII pattern", "input": { "host": "\u0435xample.com", "pattern": "example.com" }, "expected": { "matches": false } },
    { "name": "match: full-width host matches ASCII pattern", "input": { "host": "\uff45xample.com", "pattern": "example.com" }, "expected": { "matches": true } },
    { "name": "match: invalid punycode pattern is invalid", "input": { "host": "xn--a.com", "pattern": "xn--a.com" }, "expected": { "matches": false } },

    { "name": "allowed: empty allowlist allows nothing", "input": { "host": "example.com", "patterns": [] }, "expected": { "allowed": false } },
    { "name": "allowed: any matching pattern", "input": { "host": "a.example.com", "patterns": ["other.test", "*.example.com"] }, "expected": { "allowed": true } },
    { "name": "allowed: exact pattern", "input": { "host": "Example.COM", "patterns": ["example.com"] }, "expected": { "allowed": true } },
    { "name": "allowed: no pattern matches", "input": { "host": "example.org", "patterns": ["example.com", "*.example.com"] }, "expected": { "allowed": false } },
    { "name": "allowed: only invalid patterns", "input": { "host": "example.com", "patterns": ["Example.com", "*.com", "*"] }, "expected": { "allowed": false } },
    { "name": "canonical: runtime-normative (workerd/ada; Chrome, Bun and Deno reject): U+10D42 label", "input": { "host": "𐵂.example" }, "expected": { "canonical": "xn--1f0d.example" } },
    { "name": "canonical: runtime-normative (workerd/ada; Chrome, Bun and Deno reject): xn--6ud3120f38uc", "input": { "host": "xn--6ud3120f38uc.test" }, "expected": { "canonical": "xn--6ud3120f38uc.test" } },
    { "name": "canonical: runtime-normative (workerd/ada; Deno rejects): U+10D72 label", "input": { "host": "𐵲.example" }, "expected": { "canonical": "xn--fh0d.example" } },
    { "name": "canonical: runtime-normative (workerd/ada rejects; Chrome and Bun accept): U+FE07 U+05DC 3 U+10D6D label", "input": { "host": "︇ל3𐵭.example" }, "expected": { "canonical": null } },
    { "name": "canonical: runtime-normative (workerd/ada rejects; Chrome, Bun and Deno accept): xn--szbkd", "input": { "host": "xn--szbkd.example" }, "expected": { "canonical": null } },
    { "name": "pattern: wildcard on an IPv4 address is invalid (K-3)", "input": { "host": "x.1.2.3.4", "pattern": "*.1.2.3.4" }, "expected": { "matches": false } },
    { "name": "pattern: wildcard on a 0x last label is invalid, though the host is canonical (K-3)", "input": { "host": "b.a.0xg", "pattern": "*.a.0xg" }, "expected": { "matches": false } },
    { "name": "allowed: wildcard on a 0x last label allows nothing (K-3)", "input": { "host": "b.a.0xg", "patterns": ["*.a.0xg"] }, "expected": { "allowed": false } }
  ]
}
